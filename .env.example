# App
NODE_ENV=development
PORT=3000
API_PORT=4000
WORKER_PORT=4001

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ultimate_leads"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-super-secret-jwt-key"
JWT_EXPIRY="7d"

# AI (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Search (SearXNG)
SEARXNG_URL="http://localhost:8888"

# Crawl
CRAWL_MAX_DEPTH=3
CRAWL_MAX_PAGES=50
CRAWL_CONCURRENT=5
CRAWL_REQUEST_DELAY=1000

# SSRF Protection
ALLOWED_DOMAINS=""
BLOCKED_DOMAINS="localhost,127.0.0.1,169.254.169.254"

# Email
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
FROM_EMAIL="noreply@example.com"

# Webhook
WEBHOOK_SECRET=""

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
